# ==============================================================================
# Configuracion de OmniRoute para Aysen Sistemico
# Puerto por defecto de OmniRoute: 20128
# ==============================================================================
OMNIROUTE_PORT=20128
OMNIROUTE_HOST=0.0.0.0

# Clave de autenticacion para el endpoint local de OmniRoute
# Esta misma clave se configura en el Consultor de Datos (consultor.html)
OMNIROUTE_API_KEY=sk-omniroute-aysen-local

# Proveedores de Inteligencia Artificial (completar los que posea)
# OmniRoute enrutara automaticamente con fallback en cascada segun cuota y disponibilidad:
# 1. Tier 1: Suscripciones activas
# 2. Tier 2: API Keys directas
# 3. Tier 3: Modelos economicos (DeepSeek, GLM, MiniMax)
# 4. Tier 4: Tier gratuito (Free Tiers: Groq, Gemini Free, Mistral Free, etc.)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=

# Estrategia de enrutamiento por defecto: auto, auto/cheap, auto/fast, auto/coding
OMNIROUTE_DEFAULT_MODEL=auto

# Compresion de contexto activa (RTK + Caveman) para optimizar presupuesto
OMNIROUTE_COMPRESSION=true
